{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.venv": true,
    "**/*.egg-info": true,
    "**/.pytest_cache": true,
    "**/.agentscope*": true,
    "build": true,
    "dist": true,
    "**/.test-tmp": true,
    "**/.pytest_cache*": true
  }
}
