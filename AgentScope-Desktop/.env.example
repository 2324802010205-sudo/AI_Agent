# Optional session token for Vite in a browser. Tauri manages its own sidecar connection.
# VITE_BACKEND_TOKEN=
# Set these in the shell that starts Tauri if the backend is not the sibling project:
# AGENTSCOPE_BACKEND_DIR=C:\path\to\AgentScope-Backend
# AGENTSCOPE_BACKEND_PYTHON=C:\path\to\AgentScope-Backend\.venv\Scripts\python.exe
# E2E only; defaults to ../AgentScope-Backend/.agentscope/session-token:
# AGENTSCOPE_SESSION_TOKEN_FILE=C:\path\to\session-token
